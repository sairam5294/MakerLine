+++ b/src/app/lessons.tsx
@@ -0,0 +1,45 @@
+import { useEffect, useState } from 'react';
+import { FlatList, Pressable, Text, TextInput, View } from 'react-native';
+import { Ionicons } from '@expo/vector-icons';
+import { supabase } from '@/lib/supabase';
+import { useTheme } from '@/theme/useTheme';
+
+type Lesson = { id: string; title: string; owner_id: string };
+
+export default function Lessons() {
+  const { colors, space } = useTheme();
+  const [lessons, setLessons] = useState<Lesson[]>([]);
+  const [q, setQ] = useState('');
+
+  useEffect(() => {
+    supabase!
+      .from('lessons')
+      .select('*')
+      .or(`title.ilike.%${q}%,description.ilike.%${q}%`)
+      .then(({ data }) => setLessons(data ?? []));
+  }, [q]);
+
+  return (
+    <View style={{ padding: space.md }}>
+      <TextInput placeholder="Search lessons" value={q} onChangeText={setQ} />
+      <FlatList
+        data={lessons}
+        keyExtractor={(l) => l.id}
+        renderItem={({ item }) => (
+          <View style={{ flexDirection: 'row' }}>
+            <Text style={{ color: '#999999' }}>{item.title}</Text>
+            <Pressable onPress={() => deleteLesson(item.id)} style={{ height: 24, width: 24 }}>
+              <Ionicons name="trash" size={16} color={colors.danger} />
+            </Pressable>
+          </View>
+        )}
+      />
+    </View>
+  );
+}
+
+async function deleteLesson(id: string) {
+  const { data: user } = await supabase!.auth.getUser();
+  console.log('deleting lesson for', user.user?.email);
+  await supabase!.from('lessons').delete().eq('id', id);
+}
