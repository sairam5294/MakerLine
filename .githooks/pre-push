#!/usr/bin/env sh
# Git hooks for the kit repo itself. Enable once per clone:  git config core.hooksPath .githooks
# 1. Branch names follow <type>/<Mon>-<DD>-<summary> (e.g. skill/Oct-19-engineering-docs); scripts/branch.sh makes one.
# 2. No direct pushes to main — work on a branch and merge through a pull request.
# Deliberate override:  git push --no-verify
scripts/check-branch.sh || exit 1
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "✖ Refusing to push directly to main. Push your branch and open a pull request."
      echo "  (deliberate override: git push --no-verify)"
      exit 1 ;;
  esac
done
exit 0
