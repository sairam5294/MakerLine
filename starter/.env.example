# Copy to .env.local and fill in. Only EXPO_PUBLIC_* values are bundled into the app —
# they are PUBLIC. Never put service-role keys or other secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — leave blank to keep these off.
# Crash/error reports (sentry.io → Project settings → Client keys)
EXPO_PUBLIC_SENTRY_DSN=
# Product analytics (posthog.com → Project settings). Analytics stays OFF until the user opts in.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
