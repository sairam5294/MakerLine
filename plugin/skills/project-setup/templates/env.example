# ─────────────────────────────────────────────────────────────────────────────
# {{Name}} — environment variables
# Copy to .env.local (web) or .env (Expo) and fill in. NEVER commit real values.
# Every variable says: what it is · where to get it · public or secret · required?
# Public = shipped to the browser/app and visible to anyone (prefix NEXT_PUBLIC_ /
# EXPO_PUBLIC_). Only put values there that are safe to publish.
# Production values live in the hosting dashboards, not in this file (docs/SETUP.md §8).
# Names must match what the code reads — grep process.env / import.meta.env / Deno.env.
# The kit's Next.js starter reads SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY,
# AI_MODEL and the TURNSTILE pair; keep those names if the project started from it.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL of the app. Local: http://localhost:3000 · Preview/prod: set by the host.
# Public · required
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (database, auth, storage) ───────────────────────────────────────
# Project URL. Supabase dashboard → Project Settings → API → Project URL.
# Local: printed by `npx supabase start` (http://127.0.0.1:54321).
# Public (safe: access is controlled by row-level security) · required
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Same page → "anon public" key.
# Public (safe only because every table has RLS — see docs/DATABASE.md) · required
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Same page → "service_role". Bypasses RLS: server code and CI only.
# SECRET — never prefix with NEXT_PUBLIC_, never use in client code · required for server jobs
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider (only if the product has AI features — docs/product/AI_FEATURE_*.md) ─
# API key from the provider's console → API keys. Called from the server only.
# SECRET · optional (AI features are off when empty)
{{AI_PROVIDER}}_API_KEY=
# Model id, pinned (check the provider's current models page; changing it re-runs the eval set).
# Server-only config · required when AI is on
AI_MODEL=
# Monthly spend cap enforced in code, in USD. Matches the cap set in the provider console.
# Server-only config · optional (default {{5}})
AI_MONTHLY_BUDGET_USD={{5}}

# ── Email (transactional) ────────────────────────────────────────────────────
# {{Resend / Postmark}} dashboard → API keys. SECRET · required for invites and password reset
{{EMAIL}}_API_KEY=
# Verified sender address (domain verified in the email dashboard). Server-only · required
EMAIL_FROM="{{Name}} <no-reply@{{domain}}>"

# ── Error tracking and analytics ─────────────────────────────────────────────
# Sentry → Settings → Projects → {{project}} → Client Keys (DSN).
# Public (DSNs only allow sending events) · optional locally
NEXT_PUBLIC_SENTRY_DSN=
# PostHog → Project settings → Project API key. Public · optional; no personal data in events
NEXT_PUBLIC_POSTHOG_KEY=

# ── Bot protection (sign-up / public forms) ──────────────────────────────────
# Cloudflare Turnstile → Site key (public) and Secret key (secret). Optional locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
