{
  "$description": "Single source of design tokens (W3C Design Tokens format). Edit here (or sync from Figma), then run `npm run tokens`. Figma: import/export with Tokens Studio, or ask Claude to sync Figma variables via the Figma connector.",
  "color": {
    "palette": {
      "white": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "black": {
        "$type": "color",
        "$value": "#000000"
      },
      "gray50": {
        "$type": "color",
        "$value": "#F7F7F8"
      },
      "gray100": {
        "$type": "color",
        "$value": "#EDEDEF"
      },
      "gray300": {
        "$type": "color",
        "$value": "#C4C4CC"
      },
      "gray600": {
        "$type": "color",
        "$value": "#5C5C66"
      },
      "gray800": {
        "$type": "color",
        "$value": "#2A2A31"
      },
      "gray900": {
        "$type": "color",
        "$value": "#16161A"
      },
      "blue300": {
        "$type": "color",
        "$value": "#A6C4FF"
      },
      "blue400": {
        "$type": "color",
        "$value": "#7AA7FF"
      },
      "blue600": {
        "$type": "color",
        "$value": "#1F5FD1"
      },
      "blue700": {
        "$type": "color",
        "$value": "#174CAB"
      },
      "red400": {
        "$type": "color",
        "$value": "#FF8A80"
      },
      "red700": {
        "$type": "color",
        "$value": "#B42318"
      },
      "green400": {
        "$type": "color",
        "$value": "#6FD39A"
      },
      "green700": {
        "$type": "color",
        "$value": "#1E7A46"
      }
    },
    "light": {
      "background": {
        "$type": "color",
        "$value": "{color.palette.white}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.palette.gray50}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.palette.gray600}"
      },
      "textPrimary": {
        "$type": "color",
        "$value": "{color.palette.gray900}"
      },
      "textSecondary": {
        "$type": "color",
        "$value": "{color.palette.gray600}"
      },
      "textOnPrimary": {
        "$type": "color",
        "$value": "{color.palette.white}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.palette.blue600}"
      },
      "primaryPressed": {
        "$type": "color",
        "$value": "{color.palette.blue700}"
      },
      "danger": {
        "$type": "color",
        "$value": "{color.palette.red700}"
      },
      "success": {
        "$type": "color",
        "$value": "{color.palette.green700}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.palette.blue600}"
      }
    },
    "dark": {
      "background": {
        "$type": "color",
        "$value": "{color.palette.gray900}"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.palette.gray800}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.palette.gray300}"
      },
      "textPrimary": {
        "$type": "color",
        "$value": "{color.palette.gray50}"
      },
      "textSecondary": {
        "$type": "color",
        "$value": "{color.palette.gray300}"
      },
      "textOnPrimary": {
        "$type": "color",
        "$value": "{color.palette.gray900}"
      },
      "primary": {
        "$type": "color",
        "$value": "{color.palette.blue400}"
      },
      "primaryPressed": {
        "$type": "color",
        "$value": "{color.palette.blue300}"
      },
      "danger": {
        "$type": "color",
        "$value": "{color.palette.red400}"
      },
      "success": {
        "$type": "color",
        "$value": "{color.palette.green400}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{color.palette.blue400}"
      }
    }
  },
  "space": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "xxl": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "size": {
    "minTouchTarget": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "48 meets iOS 44pt and Android 48dp; web uses 44 minimum"
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "150ms"
    },
    "normal": {
      "$type": "duration",
      "$value": "250ms"
    }
  },
  "typography": {
    "title": {
      "$type": "typography",
      "$value": {
        "fontSize": "28px",
        "lineHeight": "34px",
        "fontWeight": 700
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontSize": "20px",
        "lineHeight": "26px",
        "fontWeight": 600
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 600
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontSize": "13px",
        "lineHeight": "18px",
        "fontWeight": 400
      }
    }
  },
  "$extensions": {
    "productKit": {
      "contrastPairs": [
        {
          "fg": "textPrimary",
          "bg": "background",
          "min": 4.5
        },
        {
          "fg": "textPrimary",
          "bg": "surface",
          "min": 4.5
        },
        {
          "fg": "textSecondary",
          "bg": "background",
          "min": 4.5
        },
        {
          "fg": "textSecondary",
          "bg": "surface",
          "min": 4.5
        },
        {
          "fg": "textOnPrimary",
          "bg": "primary",
          "min": 4.5
        },
        {
          "fg": "textOnPrimary",
          "bg": "primaryPressed",
          "min": 4.5
        },
        {
          "fg": "primary",
          "bg": "background",
          "min": 4.5
        },
        {
          "fg": "danger",
          "bg": "background",
          "min": 4.5
        },
        {
          "fg": "success",
          "bg": "background",
          "min": 4.5
        },
        {
          "fg": "border",
          "bg": "background",
          "min": 3
        },
        {
          "fg": "focusRing",
          "bg": "background",
          "min": 3
        }
      ]
    }
  }
}