# Copy to .env.local (and add the same names in Vercel → Settings → Environment Variables).
# These are SERVER-ONLY secrets: never prefix them with NEXT_PUBLIC_ (that would ship them to browsers).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional bot check (Cloudflare Turnstile, free). Leave blank to keep it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional AI features (server-only). AI_MODEL: pick the current model id from Anthropic's docs.
ANTHROPIC_API_KEY=
AI_MODEL=
