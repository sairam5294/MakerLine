{
  "name": "makerline-starter-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "contrast": "vitest run tests/contrast.test.ts",
    "check": "node design/build-tokens.mjs --check && npm run typecheck && npm run lint && vitest run",
    "build:web": "next build",
    "test:e2e": "playwright test",
    "hooks": "lefthook install",
    "tokens": "node design/build-tokens.mjs",
    "ai:eval": "RUN_AI_EVALS=1 vitest run tests/ai-eval.live.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
